<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zsy.module.system.userrole.mapper.SystemUserRoleMapper">

    <select id="selectRoleIdByUserId" resultType="java.lang.Long">
        SELECT role_id FROM system_user_roles WHERE user_id = #{userId}
    </select>

    <select id="selectIdsByUserId" resultType="java.lang.Long">
        SELECT id FROM system_user_roles WHERE user_id = #{userId}
    </select>
    
    <delete id="deleteByUserId">
        DELETE FROM system_user_roles WHERE user_id = #{userId}
    </delete>
</mapper> 